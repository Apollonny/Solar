{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": [
    "tests/**/*.ts",
    "src/main/services/godot-wire.ts",
    "src/main/services/godot-input-codec.ts",
    "src/main/services/credential-vault.ts"
  ]
}
